{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "should_notify",
    "summary",
    "output_markdown",
    "state_updates_json",
    "notification",
    "skip_reason",
    "error",
    "source_metadata"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS_NOTIFY",
        "SUCCESS_NO_NOTIFY",
        "SKIPPED",
        "FAILED"
      ]
    },
    "should_notify": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "output_markdown": {
      "type": "string"
    },
    "state_updates_json": {
      "type": "string"
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "event_key", "cards"],
      "properties": {
        "title": {"type": "string"},
        "body": {"type": "string"},
        "event_key": {"type": "string"},
        "cards": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "template",
              "title",
              "subtitle",
              "theme",
              "tag",
              "focus",
              "fields",
              "sections",
              "source",
              "image_url"
            ],
            "properties": {
              "template": {
                "type": "string",
                "enum": ["research_item", "market_dashboard", "price_alert"]
              },
              "title": {"type": "string"},
              "subtitle": {"type": "string"},
              "theme": {
                "type": "string",
                "enum": [
                  "blue", "wathet", "turquoise", "green", "yellow",
                  "orange", "red", "carmine", "violet", "purple",
                  "indigo", "grey"
                ]
              },
              "tag": {"type": "string"},
              "focus": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "label"],
                "properties": {
                  "value": {"type": "string"},
                  "label": {"type": "string"}
                }
              },
              "fields": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "value", "short"],
                  "properties": {
                    "label": {"type": "string"},
                    "value": {"type": "string"},
                    "short": {"type": "boolean"}
                  }
                }
              },
              "sections": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "content", "collapsed"],
                  "properties": {
                    "title": {"type": "string"},
                    "content": {"type": "string"},
                    "collapsed": {"type": "boolean"}
                  }
                }
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "url"],
                "properties": {
                  "label": {"type": "string"},
                  "url": {"type": "string"}
                }
              },
              "image_url": {"type": "string"}
            }
          }
        }
      }
    },
    "skip_reason": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "source_metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "data_timestamp", "freshness"],
        "properties": {
          "source": {"type": "string"},
          "data_timestamp": {"type": "string"},
          "freshness": {"type": "string"}
        }
      }
    }
  }
}
